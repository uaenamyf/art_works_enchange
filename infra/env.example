# CreatorHub 本地环境变量样例（不含真实密钥）
# 复制为 .env 并按需修改；切勿提交真实值。

# ---- JWT ----
JWT_SECRET=change-me-please-change-me-please-32bytes

# ---- Postgres ----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=creatorhub
DB_USER=creatorhub
DB_PASSWORD=creatorhub

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- MinIO / S3 ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=creatorhub-media
S3_ACCESS_KEY=creatorhub
S3_SECRET_KEY=creatorhub-secret

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Web ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ---- Stripe（仅支付上下文使用；本地留空）----
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
