# CreatorHub production environment template. Replace every placeholder locally.
# Never commit the filled .env file or send credentials through chat.

DB_NAME=creatorhub
DB_USER=creatorhub
DB_PASSWORD=replace-with-a-long-random-database-password

JWT_SECRET=replace-with-at-least-32-random-characters
REDIS_PASSWORD=replace-with-a-long-random-redis-password

# MinIO S3-compatible storage runs inside Docker. Keep it private.
S3_REGION=us-east-1
S3_BUCKET=creatorhub-media
S3_ACCESS_KEY=replace-with-minio-admin-user
S3_SECRET_KEY=replace-with-a-long-random-minio-password

CORS_ALLOWED_ORIGINS=https://creatormall.shop
NEXT_PUBLIC_API_BASE_URL=https://api.creatormall.shop
COOKIE_SECURE=true
ARTWORK_REVIEW_ENABLED=true
NPM_REGISTRY=https://registry.npmjs.org