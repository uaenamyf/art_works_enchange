# CreatorHub production environment template. Replace every placeholder locally.
# Never commit the filled .env file or send credentials through chat.

DB_NAME=creatorhub
DB_USER=admin
DB_PASSWORD=replace-with-your-database-password
API_PORT=18080
WEB_PORT=3000

JWT_SECRET=replace-with-at-least-32-random-characters
REDIS_PASSWORD=replace-with-your-redis-password

# MinIO S3-compatible storage runs inside Docker. Keep it private.
S3_REGION=us-east-1
S3_BUCKET=creatorhub-media
S3_ACCESS_KEY=admin
S3_SECRET_KEY=replace-with-your-minio-password

CORS_ALLOWED_ORIGINS=https://creatormall.shop
WEB_PUBLIC_URL=https://creatormall.shop
NEXT_PUBLIC_API_BASE_URL=https://api.creatormall.shop
COOKIE_SECURE=true
ARTWORK_REVIEW_ENABLED=true
NPM_REGISTRY=https://registry.npmjs.org