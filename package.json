{
  "name": "creatorhub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "web:dev": "pnpm --filter @creatorhub/web dev",
    "web:build": "pnpm --filter @creatorhub/web build",
    "web:start": "pnpm --filter @creatorhub/web start",
    "web:api:generate": "pnpm --filter @creatorhub/web api:generate",
    "web:lint": "pnpm --filter @creatorhub/web lint",
    "web:typecheck": "pnpm --filter @creatorhub/web typecheck",
    "web:test": "pnpm --filter @creatorhub/web test"
  }
}
